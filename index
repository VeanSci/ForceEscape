  <circle cx="185" cy="88" r="4" fill="#2c3151"/><line x1="185" y1="82" x2="320" y2="82" stroke="#e02020" stroke-width="5"/><path d="M320 72 L338 82 L320 92 Z" fill="#e02020"/><text x="300" y="66" font-size="16" font-weight="900" fill="#e02020" text-anchor="middle">3 N</text>
  <line x1="185" y1="96" x2="275" y2="96" stroke="#3f4e9e" stroke-width="5"/><path d="M275 86 L293 96 L275 106 Z" fill="#3f4e9e"/><text x="300" y="112" font-size="16" font-weight="900" fill="#3f4e9e" text-anchor="middle">2 N</text></svg>`,
