  <rect x="170" y="44" width="40" height="32" rx="4" fill="#cf9520"/><circle cx="190" cy="60" r="3.5" fill="#2c3151"/><line x1="190" y1="60" x2="300" y2="60" stroke="#e02020" stroke-width="5"/><path d="M300 50 L318 60 L300 70 Z" fill="#e02020"/><text x="260" y="44" font-size="14" text-anchor="middle" fill="#e02020" font-weight="900">당기는 힘</text></svg>`,
cap:`<svg viewBox="0 0 380 110" width="380"><rect x="20" y="70" width="340" height="12" fill="#8a6a44"/><rect x="170" y="46" width="44" height="24" rx="6" fill="#e02020"/>
  <line x1="220" y1="40" x2="300" y2="40" stroke="#2c3151" stroke-width="4"/><path d="M300 32 L316 40 L300 48 Z" fill="#2c3151"/><text x="260" y="28" font-size="14" text-anchor="middle" fill="#2c3151" font-weight="900">미끄러지는 방향</text>
  <g stroke="#cfd5ea" stroke-width="3"><line x1="120" y1="52" x2="155" y2="52"/><line x1="128" y1="62" x2="160" y2="62"/></g></svg>`,
crate:`<svg viewBox="0 0 380 130" width="380"><rect x="20" y="100" width="340" height="10" fill="#8d8466"/><rect x="150" y="40" width="100" height="60" fill="#b48a55" stroke="#7a5a36" stroke-width="3"/>
  <circle cx="70" cy="45" r="12" fill="#3f4e9e"/><line x1="70" y1="57" x2="80" y2="95" stroke="#3f4e9e" stroke-width="6"/><line x1="76" y1="70" x2="148" y2="70" stroke="#3f4e9e" stroke-width="5" stroke-linecap="round"/><circle cx="200" cy="70" r="4" fill="#2c3151"/><line x1="200" y1="70" x2="270" y2="70" stroke="#3f4e9e" stroke-width="5"/><path d="M270 62 L286 70 L270 78 Z" fill="#3f4e9e"/><text x="320" y="75" font-size="13" text-anchor="middle" fill="#3f4e9e" font-weight="900">미는 힘</text>
  <text x="200" y="30" font-size="14" text-anchor="middle" fill="#2c3151" font-weight="900">움직이지 않는다!</text></svg>`,
scale:`<svg viewBox="0 0 380 170" width="380"><g transform="translate(60 0)"><rect x="40" y="10" width="20" height="60" rx="4" fill="#cfd5ea" stroke="#5b627c" stroke-width="2"/><line x1="50" y1="70" x2="50" y2="90" stroke="#5b627c" stroke-width="2"/><rect x="32" y="90" width="36" height="30" rx="3" fill="#8a93b3"/><text x="50" y="108" font-size="12" text-anchor="middle" fill="#fff" font-weight="900">A</text><text x="50" y="150" font-size="16" text-anchor="middle" fill="#2c3151" font-weight="900">(가) 40 N</text></g>
  <g transform="translate(200 0)"><rect x="40" y="10" width="20" height="60" rx="4" fill="#cfd5ea" stroke="#5b627c" stroke-width="2"/><line x1="50" y1="70" x2="50" y2="90" stroke="#5b627c" stroke-width="2"/><rect x="0" y="80" width="100" height="56" fill="rgba(60,140,230,.35)" stroke="#5aa0dd" stroke-width="2"/><rect x="32" y="90" width="36" height="30" rx="3" fill="#8a93b3"/><text x="50" y="108" font-size="12" text-anchor="middle" fill="#fff" font-weight="900">A</text><text x="50" y="158" font-size="16" text-anchor="middle" fill="#2c3151" font-weight="900">(나) 30 N</text></g></svg>`,
tug:`<svg viewBox="0 0 380 110" width="380"><line x1="60" y1="60" x2="320" y2="60" stroke="#8a6a44" stroke-width="3" opacity=".5"/><rect x="180" y="52" width="20" height="16" fill="#e02020" opacity=".35"/>
  <circle cx="190" cy="60" r="4" fill="#2c3151"/><line x1="190" y1="60" x2="130" y2="60" stroke="#3f4e9e" stroke-width="5"/><path d="M130 52 L114 60 L130 68 Z" fill="#3f4e9e"/><text x="150" y="42" font-size="15" text-anchor="middle" fill="#3f4e9e" font-weight="900">2 N</text>
  <line x1="190" y1="60" x2="280" y2="60" stroke="#e02020" stroke-width="5"/><path d="M280 52 L296 60 L280 68 Z" fill="#e02020"/><text x="250" y="88" font-size="15" text-anchor="middle" fill="#e02020" font-weight="900">3 N</text></svg>`,
lump:`<svg viewBox="0 0 380 140" width="380"><rect x="100" y="10" width="180" height="120" fill="rgba(60,140,230,.3)" stroke="#5aa0dd" stroke-width="3"/><path d="M160 128 l14 -22 l34 -2 l12 24 z" fill="#8a93b3"/>
  <text x="190" y="50" font-size="14" text-anchor="middle" fill="#1b4f80" font-weight="900">바닥에 가라앉음</text></svg>`
};


/* ── 상태 ── */
let S=null,KEY="",tick=null;
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
function load(k){try{return JSON.parse(localStorage.getItem(k)||"null");}catch(e){return null;}}
function fresh(c,t){return {cls:c,team:t,start:Date.now(),room:0,end:null,timeUp:false,
  rooms:ROOMS.map(()=>({wrong:0,hint:false,seen:{},items:{},used:{},opened:{},clues:{},score:null}))};}
const roomScore=st=>Math.max(40,100-20*st.wrong-(st.hint?30:0));
const remain=()=>Math.max(0,LIMIT-((S.end||Date.now())-S.start));
const bonus=()=>(S.end&&!S.timeUp)?Math.floor(remain()/60000)*5:0;
const total=()=>S.rooms.reduce((a,r)=>a+(r.score||0),0)+bonus();

/* ── 입장 ── */
function gateKey(){const c=$("selCls").value,t=$("selTeam").value;return (c&&t)?`esc26b_${c}_${t}`:"";}
function gateCheck(){const k=gateKey(),old=k&&load(k);
  $("resumeNote").hidden=!old;$("resetLink").hidden=!old;$("resetBox").hidden=true;
  if(old){$("resumeNote").textContent=old.end?"이 조는 이미 끝났어요. 입장하면 결과 화면이 보여요.":`이어서 합니다 (방 ${old.room+1}부터).`;$("goBtn").textContent=old.end?"결과 보기":"이어하기";}
  else $("goBtn").textContent="입장하기";}
$("selCls").onchange=$("selTeam").onchange=gateCheck;
$("resetLink").onclick=()=>{$("resetBox").hidden=false;$("resetTxt").focus();};
$("resetGo").onclick=()=>{if($("resetTxt").value.trim()==="처음부터"){try{localStorage.removeItem(gateKey());}catch(e){}$("resetTxt").value="";gateCheck();}};
$("goBtn").onclick=()=>{const k=gateKey();if(!k){$("resumeNote").hidden=false;$("resumeNote").textContent="반과 조를 골라 주세요.";return;}
  KEY=k;S=load(k)||fresh($("selCls").value,$("selTeam").value);save();
  $("gate").hidden=true;$("who").textContent=`${S.cls}반 ${S.team}조`;
  if(S.end)return showResult();
  $("bar").hidden=false;$("room").hidden=false;tick=setInterval(onTick,500);onTick();drawRoom();};
function onTick(){const r=remain(),m=Math.floor(r/60000),s=Math.floor(r%60000/1000);
  $("timer").textContent=`⏱ ${m}:${String(s).padStart(2,"0")}`;$("timer").classList.toggle("warn",r<5*60000);
  if(r<=0&&!S.end){S.end=S.start+LIMIT;S.timeUp=true;save();closeModal();showResult();}}

/* ── 방 그리기 ── */
function drawBar(){
  $("doors").innerHTML=ROOMS.map((r,i)=>{const st=S.rooms[i];const c=st.score!==null?"done":i===S.room?"now":"";
    return `<span class="dot ${c}" title="${i+1}. ${esc(r.name)}">${st.score!==null?"🔓":i===S.room?r.icon:"🔒"}</span>`;}).join("");
  $("scoreNow").textContent=S.rooms.reduce((a,r)=>a+(r.score||0),0);}
function drawRoom(){
  const R=ROOMS[S.room],st=S.rooms[S.room];
  drawBar();
  $("rName").textContent=`${R.icon} ${S.room+1}. ${R.name}`;$("rTopic").textContent=R.topic;
  $("intro").textContent=R.intro;
  $("hintBtn").hidden=st.hint||st.score!==null;$("hintBtn").classList.remove("sure");$("hintBtn").textContent="💡 힌트 (−30)";
  $("hintBox").hidden=!st.hint;$("hintBox").textContent=R.hint;
  $("scene").innerHTML=SCENES[R.scene];
  $("scene").querySelectorAll(".obj").forEach(g=>{
    const id=g.dataset.obj,o=R.objects[id];if(!o)return;
    if(st.seen[id])g.classList.add("seen");
    try{const bb=g.getBBox(),r=document.createElementNS("http://www.w3.org/2000/svg","rect");   // 빈 곳을 눌러도 되게
      r.setAttribute("x",bb.x);r.setAttribute("y",bb.y);r.setAttribute("width",bb.width);r.setAttribute("height",bb.height);r.setAttribute("fill","#000");r.setAttribute("fill-opacity","0");g.insertBefore(r,g.firstChild);}catch(e){}
    g.addEventListener("click",()=>clickObj(id));
    g.addEventListener("mousemove",e=>{const b=$("sceneWrap").getBoundingClientRect();$("tip").hidden=false;$("tip").textContent=o.label;$("tip").style.left=(e.clientX-b.left)+"px";$("tip").style.top=(e.clientY-b.top)+"px";});
    g.addEventListener("mouseleave",()=>$("tip").hidden=true);
  });
  drawInv();
  if(st.score!==null)showClear();else $("clear").hidden=true;
}
function drawInv(){
  const R=ROOMS[S.room],st=S.rooms[S.room];
  const items=Object.keys(R.items).filter(k=>st.items[k]&&!st.used[k]).map(k=>`<span class="slot item">${R.items[k].icon} ${esc(R.items[k].name)}</span>`);
  const clues=Object.keys(R.clues).filter(k=>st.clues[k]).map(k=>`<button class="slot" data-c="${k}"><span class="sy">${R.clues[k].sym}</span>${esc(R.clues[k].title)}</button>`);
  $("invItems").innerHTML=items.length?items.join(""):`<span class="empty">없음</span>`;
  $("invClues").innerHTML=clues.length?clues.join(""):`<span class="empty">아직 없음 — 방의 물건을 눌러 보세요! (누르면 다시 볼 수 있어요)</span>`;
  $("invClues").querySelectorAll("button[data-c]").forEach(b=>b.onclick=()=>openClue(b.dataset.c));
}
/* ── 물건 누르기 ── */
function clickObj(id){
  const R=ROOMS[S.room],st=S.rooms[S.room],o=R.objects[id];
  st.seen[id]=true;save();
  if(o.type==="lock")return openLock();
  if(o.type==="decoy")return modal(`<div class="mt">${esc(o.label)}</div><div class="mtext">${esc(o.text)}</div>`);
  if(o.type==="item"){
    const had=st.items[o.item];st.items[o.item]=true;save();drawInv();
    return modal(`<div class="mt">${esc(o.label)}</div><div class="mtext">${had?"이미 살펴본 곳이다.":esc(o.text)}</div>${had?"":`<div class="gain">${R.items[o.item].icon} ${esc(R.items[o.item].name)}을(를) 얻었다!</div>`}`);
  }
  if(o.type==="locked"&&!st.opened[id]){
    if(!st.items[o.need])return modal(`<div class="mt">${esc(o.label)}</div><div class="mtext">🔒 ${esc(o.lockedText)}</div>`);
    st.opened[id]=true;st.used[o.need]=true;save();
    return openClue(o.clue,o.openText+` (${R.items[o.need].name}은(는) 다 썼다)`);
  }
  openClue(o.clue);
}
function openClue(cid,pre){
  const R=ROOMS[S.room],st=S.rooms[S.room],c=R.clues[cid];
  const first=!st.clues[cid];st.clues[cid]=true;save();drawInv();
  modal(`${pre?`<div class="mtext" style="margin-bottom:10px">🔓 ${esc(pre)}</div>`:""}
    <div class="mt"><span class="sy">${c.sym}</span>${esc(c.title)}</div>
    ${c.fig?`<div class="mfig">${FIGS[c.fig]}</div>`:""}
    <div class="mq">${esc(c.q)}</div>
    ${c.opts?`<ul class="mo">${c.opts.map((o,i)=>`<li>${CIRC[i]} ${esc(o)}</li>`).join("")}</ul>`:""}
    <div class="mtail">🔑 ${esc(c.tail)}</div>
    ${first?`<div class="gain">📜 단서 ${c.sym}을(를) 단서 칸에 넣었다</div>`:""}`,true);
}

/* ── 자물쇠 ── */
let dialV=[];
function openLock(){
  const R=ROOMS[S.room],st=S.rooms[S.room],L=R.lock;
  if(st.score!==null)return modal(`<div class="mt">${esc(R.objects.door.label)}</div><div class="mtext">이미 열린 문이다. 다음 방으로!</div>`);
  const sets=L.dials.map(d=>Array.isArray(d.set)?d.set:DIAL[d.set]);
  dialV=L.dials.map(()=>0);
  modal(`<div class="mt">🔒 ${esc(L.label)}</div><div class="mtext" style="font-size:15px">${esc(L.desc)}</div>
    <div class="lockBody" id="lockBody"><div class="dials">${L.dials.map((d,i)=>`<div class="dial"><span class="sy">${d.sym}</span><button data-i="${i}" data-d="-1">▲</button><div class="v ${sets[i].some(x=>x.length>2)?"wide":""}" id="dv${i}">${esc(sets[i][0])}</div><button data-i="${i}" data-d="1">▼</button></div>`).join("")}</div>
    <button class="big gold" id="tryLock">열어 보기</button><div class="lockMsg" id="lockMsg"></div></div>`);
  $("mBody").querySelectorAll(".dial button").forEach(b=>b.onclick=()=>{const i=+b.dataset.i,set=sets[i];dialV[i]=(dialV[i]+(+b.dataset.d)+set.length)%set.length;$("dv"+i).textContent=set[dialV[i]];$("lockMsg").textContent="";});
  $("tryLock").onclick=()=>{
    const code=dialV.map((v,i)=>sets[i][v]).join("|");
    if(h53(SALT+"r"+R.id+"|"+code)===L.h){st.score=roomScore(st);save();closeModal();drawBar();showClear();}
    else{st.wrong++;save();$("lockMsg").className="lockMsg bad";$("lockMsg").textContent=`철컥… 열리지 않는다! (이 방 −${20*st.wrong}점)`;
      const lb=$("lockBody");lb.classList.remove("shake");void lb.offsetWidth;lb.classList.add("shake");}
  };
}

/* ── 힌트 ── */
$("hintBtn").onclick=e=>{const b=e.currentTarget;if(!b.classList.contains("sure")){b.classList.add("sure");b.textContent="정말 열까요? (−30)";return;}
  S.rooms[S.room].hint=true;save();drawRoom();};

/* ── 팝업 ── */
function modal(html,paper){$("mBody").innerHTML=html;$("mBox").classList.toggle("paper",!!paper);$("modal").hidden=false;}
function closeModal(){$("modal").hidden=true;}
$("mClose").onclick=closeModal;$("modal").onclick=e=>{if(e.target.id==="modal")closeModal();};
addEventListener("keydown",e=>{if(e.key==="Escape")closeModal();});

/* ── 방 탈출 ── */
function showClear(){
  const st=S.rooms[S.room],last=S.room===ROOMS.length-1,c=$("clear");c.hidden=false;$("hintBtn").hidden=true;
  c.innerHTML=`<div class="t">${last?"🎉 마지막 문이 열렸다!":"🚪 철컥! 문이 열렸다!"}</div>
    <div class="s">이 방 점수 ${st.score}점 (자물쇠 틀림 ${st.wrong}번${st.hint?" · 힌트 사용":""})</div>
    <button class="big ${last?"gold":""}" id="nextBtn">${last?"연구소 탈출하기 →":"다음 방으로 →"}</button>`;
  $("nextBtn").onclick=()=>{if(last){S.end=Date.now();save();showResult();}else{S.room++;save();drawRoom();scrollTo(0,0);}};
  c.scrollIntoView({behavior:"smooth",block:"center"});
}

/* ── 결과 ── */
function showResult(){
  clearInterval(tick);["bar","room"].forEach(id=>$(id).hidden=true);
  const used=Math.min(LIMIT,S.end-S.start),um=Math.floor(used/60000),us=Math.floor(used%60000/1000);
  const rows=ROOMS.map((r,i)=>{const st=S.rooms[i];return `<tr><td>${r.icon} ${i+1}. ${esc(r.name)}</td><td class="r">${st.score===null?"—":`틀림 ${st.wrong}${st.hint?" · 힌트":""}`}</td><td class="r">${st.score===null?0:st.score}</td></tr>`;}).join("");
  $("result").hidden=false;
  $("result").innerHTML=`<div class="card"><div class="logo">${S.timeUp?"⏰":"🏆"}</div><div id="rTitle">${S.timeUp?"시간 종료!":"탈출 성공!"}</div>
    <div id="rWho">${S.cls}반 ${S.team}조</div><div id="rTotal">${total()}</div><div class="sub">점</div>
    <table><tr><th>방</th><th class="r">기록</th><th class="r">점수</th></tr>${rows}
    <tr><td>⏱ 시간 보너스</td><td class="r">${S.timeUp?"시간 종료":`${um}분 ${us}초 만에 탈출`}</td><td class="r">${bonus()}</td></tr>
    <tr class="sum"><td>합계</td><td></td><td class="r">${total()}</td></tr></table>
    <div class="note">이 화면을 그대로 두고 선생님께 점수를 알려 주세요.</div></div>`;
}
</script>
